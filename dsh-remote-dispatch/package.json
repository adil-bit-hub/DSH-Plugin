{
  "name": "dsh-remote-dispatch",
  "version": "0.2.0",
  "private": true,
  "description": "在中控端直接管理云端 DSH：建项目、传文件、开任务、取结果，像本地一样操作。任务在云端独立进程执行，本地断网/关机不影响。",
  "type": "module",
  "main": "index.js",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "client.js",
    "src",
    "cordis.patch.yml",
    "remote",
    "README.md"
  ],
  "keywords": [
    "dsh-plugin",
    "remote",
    "dispatch",
    "cloud",
    "ssh",
    "project",
    "workspace"
  ],
  "license": "MIT",
  "author": "tragi",
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-client-ui-settings"
      ]
    }
  }
}
